# TypeSafe AI. GMO Public API does not need credentials.
TYPESAFE_API_KEY=

# Optional: GMO外国為替FX Private API read-only account display.
# Create an API key with only the account/position read permissions you need.
# JevPip does not implement order POST endpoints.
GMO_FX_API_KEY=
GMO_FX_API_SECRET=

# External official calendar refresh interval while Observer is running.
# Values below 60 seconds are clamped to 60 at runtime.
CONTEXT_REFRESH_SECONDS=900

# Safety invariant. Live trading is not implemented.
LIVE_TRADING=false
